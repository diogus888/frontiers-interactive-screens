- name: ScreenMapExt
  type: textDAT
  parameters:
    language: python
  flags:
  - viewer
  position: [0, 400]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
  dat_content: |
    from __future__ import annotations
    from typing import Optional

    # ScreenMapExt -- the screen layout tool.
    #
    # `screens` (table DAT, EDIT THIS ONE) is the single source of truth: one row per physical
    # screen with its centre position and size in CENTIMETRES, its native pixel resolution and
    # its output display index. Everything else is derived from it by RebuildLayout() into the
    # `layout` table, which the mockup rectangles/crops in the Mockup COMP, the editor tiles and
    # the Window COMPs read through Layout() / Px() / Display() expressions.
    #
    # World model: 1 world unit = Cmperunit centimetres (the mockup rectangles are in world
    # units). Each interactive group's bounding box is fitted, centred, into a Panew x Paneh
    # canvas (the group's hydra pane), which is what the per-screen crop pixels encode.

    _PAGE = 'ScreenMap'
    _SCREEN_COLS = ['name', 'group', 'xcm', 'ycm', 'wcm', 'hcm', 'pxw', 'pxh', 'display', 'depth']
    _LAYOUT_COLS = ['name', 'group', 'tx', 'ty', 'sizeu', 'sizev', 'tz', 'layer',
                    'cropleft', 'cropright', 'cropbottom', 'croptop',
                    'panx', 'pany', 'panw', 'panh']
    _TZ_STEP, _TZ_BASE = 0.05, -0.4     # depth 0 (the back) renders at tz -0.4; each step forward adds 0.05 world units
    _UNCROPPED_GROUPS = ('u',)   # non-interactive screens keep their own centre crops of the clips
    _GROUP_COLS = ['group', 'panx', 'pany', 'panw', 'panh']   # each interactive group's FULL canvas in editor pixels


    def _ensurePage(comp: COMP, name: str) -> Page:
        for page in comp.customPages:
            if page.name == name:
                return page
        return comp.appendCustomPage(name)


    def _ensurePar(comp: COMP, page: Page, name: str, style: str, **attrs) -> Par:
        found = [p for p in comp.customPars if p.tupletName == name]
        created = not found
        if created:
            getattr(page, 'append' + style)(name)
            found = [p for p in comp.customPars if p.tupletName == name]
        for p in found:
            for key, value in attrs.items():
                setattr(p, key, value)
            if created and 'default' in attrs and style not in ('Pulse',):
                p.val = attrs['default']
        return found[0]


    class ScreenMapExt:
        def __init__(self, ownerComp: COMP) -> None:
            self.ownerComp = ownerComp
            self._ensurePars()
            self._ensureTables()

        def onInitTD(self) -> None:
            run('args[0].RebuildLayout()', self, delayFrames=5)

        def onDestroyTD(self) -> None:
            pass

        # ---- schema ------------------------------------------------------------------
        def _ensurePars(self) -> None:
            c = self.ownerComp
            page = _ensurePage(c, _PAGE)
            _ensurePar(c, page, 'Mockup', 'COMP', label='Mockup COMP', default='base1',
                       help='The COMP holding the mockup: rect_<screen> rectangle POPs and crop_<screen> Crop TOPs that this tool drives, plus the crop_paneN group canvases.')
            _ensurePar(c, page, 'Cmperunit', 'Float', label='cm per World Unit', default=100.0, min=0.001, clampMin=True, normMin=1, normMax=200,
                       help='How many centimetres one world unit of the mockup represents. The rectangles are sized as cm / this value. 100 means 1 unit = 1 m.')
            _ensurePar(c, page, 'Panew', 'Int', label='Group Canvas Width', default=1280, min=1, clampMin=True, normMax=3840,
                       help='Pixel width of each interactive group canvas (the hydra pane the crops cut from).')
            _ensurePar(c, page, 'Paneh', 'Int', label='Group Canvas Height', default=720, min=1, clampMin=True, normMax=2160,
                       help='Pixel height of each interactive group canvas.')
            _ensurePar(c, page, 'Viewx', 'Float', label='Editor View Centre X', default=0.0, normMin=-5, normMax=5, startSection=True,
                       help='World-unit X at the centre of the editor panel.')
            _ensurePar(c, page, 'Viewy', 'Float', label='Editor View Centre Y', default=0.0, normMin=-5, normMax=5,
                       help='World-unit Y at the centre of the editor panel.')
            _ensurePar(c, page, 'Vieww', 'Float', label='Editor View Width', default=5.4, min=0.1, clampMin=True, normMin=1, normMax=20,
                       help='How many world units the editor panel spans horizontally. Smaller = zoomed in.')
            _ensurePar(c, page, 'Snapcm', 'Float', label='Drag Snap (cm)', default=0.0, min=0, clampMin=True, normMax=50,
                       help='Dragged screen positions snap to multiples of this many cm. 0 = no snapping.')
            _ensurePar(c, page, 'Ghostopacity', 'Float', label='Hover Ghost Opacity', default=0.15, min=0, max=1, clampMin=True, clampMax=True,
                       help='Opacity of the full group canvas (the whole hydra pane) shown behind a group while the cursor is over one of its screens in the editor.')
            _ensurePar(c, page, 'Rebuild', 'Pulse', label='Rebuild Layout', startSection=True,
                       help='Recompute the layout table from the screens table. Normally automatic on every table edit.')

        def _ensureTables(self) -> None:
            c = self.ownerComp
            screens = c.op('screens')
            if screens is None:
                screens = c.create(tableDAT, 'screens')
                screens.nodeX, screens.nodeY = 0, 0
                screens.clear()
                screens.appendRow(_SCREEN_COLS)
            layout = c.op('layout')
            if layout is None:
                layout = c.create(tableDAT, 'layout')
                layout.nodeX, layout.nodeY = 400, 0
            if layout.numRows == 0:
                layout.appendRow(_LAYOUT_COLS)
            groups = c.op('groups')
            if groups is None:
                groups = c.create(tableDAT, 'groups')
                groups.nodeX, groups.nodeY = 800, -200
            if groups.numRows == 0:
                groups.appendRow(_GROUP_COLS)

        # ---- public API (read by expressions on the mockup, editor and Window COMPs) ----
        def Screens(self) -> list:
            """Names of every screen in the screens table, in table order."""
            t = self.ownerComp.op('screens')
            return [t[r, 'name'].val for r in range(1, t.numRows)]

        def Group(self, name: str) -> str:
            """Group id of a screen (g1, g2, g3 or u)."""
            t = self.ownerComp.op('screens')
            cell = t[name, 'group']
            return cell.val if cell is not None else ''

        def Layout(self, name: str, col: str) -> float:
            """A derived layout value for a screen: tx ty sizeu sizev (world units), cropleft cropright cropbottom croptop (canvas px), panx pany panw panh (editor px)."""
            cell = self.ownerComp.op('layout')[name, col]
            if cell is None or cell.val == '':
                return 0.0
            return float(cell.val)

        def Px(self, name: str, axis: str) -> int:
            """Native pixel size of a screen along 'w' or 'h'; 0 when unknown."""
            cell = self.ownerComp.op('screens')[name, 'pxw' if axis == 'w' else 'pxh']
            try:
                return int(float(cell.val)) if cell is not None else 0
            except ValueError:
                return 0

        def Display(self, name: str) -> int:
            """Output display index for a screen's Window COMP."""
            cell = self.ownerComp.op('screens')[name, 'display']
            try:
                return int(float(cell.val)) if cell is not None else 0
            except ValueError:
                return 0

        def SourceTOP(self, name: str) -> Optional[TOP]:
            """The mockup crop TOP showing this screen's content (crop_<name> in the Mockup COMP)."""
            mock = self.ownerComp.par.Mockup.eval()
            return mock.op('crop_' + name) if mock is not None else None

        def RebuildLayout(self) -> None:
            """Derive the layout table (world units, canvas crop pixels, editor pixels) from the screens table."""
            c = self.ownerComp
            screens, layout = c.op('screens'), c.op('layout')
            unit = float(c.par.Cmperunit.eval())
            panew, paneh = float(c.par.Panew.eval()), float(c.par.Paneh.eval())
            rows = []
            for r in range(1, screens.numRows):
                try:
                    depth = int(float(screens[r, 'depth'])) if screens[r, 'depth'] is not None and screens[r, 'depth'].val != '' else 0
                    rows.append({
                        'name': screens[r, 'name'].val, 'group': screens[r, 'group'].val,
                        'tx': float(screens[r, 'xcm']) / unit, 'ty': float(screens[r, 'ycm']) / unit,
                        'sizeu': float(screens[r, 'wcm']) / unit, 'sizev': float(screens[r, 'hcm']) / unit,
                        'tz': _TZ_BASE + depth * _TZ_STEP,   # mockup Z: depth 0 is the back
                        'layer': depth + 1,                  # editor tile layer: ghosts sit at 0, tiles above
                    })
                except (ValueError, TypeError) as e:
                    debug('screens row %d skipped: %s' % (r, e))
            # per-group fit into the canvas
            groups = {}
            for s in rows:
                groups.setdefault(s['group'], []).append(s)
            for g, members in groups.items():
                if g in _UNCROPPED_GROUPS:
                    continue
                minx = min(s['tx'] - s['sizeu'] / 2 for s in members)
                maxx = max(s['tx'] + s['sizeu'] / 2 for s in members)
                miny = min(s['ty'] - s['sizev'] / 2 for s in members)
                maxy = max(s['ty'] + s['sizev'] / 2 for s in members)
                bw, bh = max(maxx - minx, 1e-9), max(maxy - miny, 1e-9)
                scale = min(panew / bw, paneh / bh)
                offx, offy = (panew - bw * scale) / 2, (paneh - bh * scale) / 2
                for s in members:
                    s['cropleft'] = round(offx + (s['tx'] - s['sizeu'] / 2 - minx) * scale)
                    s['cropright'] = round(offx + (s['tx'] + s['sizeu'] / 2 - minx) * scale)
                    s['cropbottom'] = round(offy + (s['ty'] - s['sizev'] / 2 - miny) * scale)
                    s['croptop'] = round(offy + (s['ty'] + s['sizev'] / 2 - miny) * scale)
                # the whole canvas, in world units: the fitted bbox plus the letterbox margins
                groups[g] = {'cx': (minx + maxx) / 2, 'cy': (miny + maxy) / 2, 'w': panew / scale, 'h': paneh / scale}
            # editor panel pixels (panel origin bottom-left, Y up)
            editor = c.op('editor')
            ew = float(editor.par.w.eval()) if editor is not None else panew
            eh = float(editor.par.h.eval()) if editor is not None else paneh
            vieww = float(c.par.Vieww.eval())
            ppu = ew / vieww
            left = float(c.par.Viewx.eval()) - vieww / 2
            bottom = float(c.par.Viewy.eval()) - (eh / ppu) / 2
            for s in rows:
                s['panx'] = round((s['tx'] - s['sizeu'] / 2 - left) * ppu)
                s['pany'] = round((s['ty'] - s['sizev'] / 2 - bottom) * ppu)
                s['panw'] = max(1, round(s['sizeu'] * ppu))
                s['panh'] = max(1, round(s['sizev'] * ppu))
            out = [_LAYOUT_COLS] + [[self._fmt(s.get(col, '')) for col in _LAYOUT_COLS] for s in rows]
            layout.clear()
            layout.appendRows(out)
            gout = [_GROUP_COLS]
            for g, box in groups.items():
                if not isinstance(box, dict):
                    continue
                gout.append([g, self._fmt(round((box['cx'] - box['w'] / 2 - left) * ppu)),
                             self._fmt(round((box['cy'] - box['h'] / 2 - bottom) * ppu)),
                             self._fmt(max(1, round(box['w'] * ppu))), self._fmt(max(1, round(box['h'] * ppu)))])
            gtable = c.op('groups')
            gtable.clear()
            gtable.appendRows(gout)

        def GroupLayout(self, group: str, col: str) -> float:
            """The full canvas of an interactive group in editor pixels: panx pany panw panh."""
            cell = self.ownerComp.op('groups')[group, col]
            if cell is None or cell.val == '':
                return 0.0
            return float(cell.val)

        def GroupTOP(self, group: str) -> Optional[TOP]:
            """The group's whole hydra pane (crop_paneN in the Mockup COMP), the visual its screens are windows into."""
            mock = self.ownerComp.par.Mockup.eval()
            if mock is None or not group.startswith('g'):
                return None
            return mock.op('crop_pane' + group[1:])

        def GroupHovered(self, group: str) -> bool:
            """True while the cursor is over any editor tile of this group (drives the hover ghost)."""
            editor = self.ownerComp.op('editor')
            if editor is None:
                return False
            t = self.ownerComp.op('screens')
            for r in range(1, t.numRows):
                if t[r, 'group'].val != group:
                    continue
                tile = editor.op('screen_' + t[r, 'name'].val)
                if tile is not None and tile.panel.inside:
                    return True
            return False

        # ---- wiring (called by this COMP's own DATs) ---------------------------------------
        def setScreenPosition(self, name: str, xcm: float, ycm: float) -> None:
            """Move a screen's centre (cm); used by the editor drag. Snaps to Snapcm when set."""
            snap = float(self.ownerComp.par.Snapcm.eval())
            if snap > 0:
                xcm, ycm = round(xcm / snap) * snap, round(ycm / snap) * snap
            t = self.ownerComp.op('screens')
            if t[name, 'xcm'] is None:
                debug('setScreenPosition: no screen named %r' % name)
                return
            t[name, 'xcm'] = self._fmt(xcm)
            t[name, 'ycm'] = self._fmt(ycm)

        def sendToBack(self, name: str) -> None:
            """Make a screen render behind every other one (right-click in the editor): it gets depth 0, the rest keep their order above it."""
            t = self.ownerComp.op('screens')
            if t[name, 'depth'] is None:
                debug('sendToBack: no screen named %r' % name)
                return
            order = []
            for r in range(1, t.numRows):
                n = t[r, 'name'].val
                try:
                    d = int(float(t[r, 'depth']))
                except (ValueError, TypeError):
                    d = 0
                order.append((d, n))
            order.sort()
            ranked = [n for _, n in order if n != name]
            t[name, 'depth'] = '0'
            for i, n in enumerate(ranked):
                t[n, 'depth'] = str(i + 1)

        def editorToCm(self, u: float, v: float) -> tuple:
            """Editor panel position (0..1 u/v) -> world position in cm."""
            c = self.ownerComp
            editor = c.op('editor')
            ew = float(editor.par.w.eval()) if editor is not None else float(c.par.Panew.eval())
            eh = float(editor.par.h.eval()) if editor is not None else float(c.par.Paneh.eval())
            vieww = float(c.par.Vieww.eval())
            ppu = ew / vieww
            unit = float(c.par.Cmperunit.eval())
            x = float(c.par.Viewx.eval()) - vieww / 2 + u * ew / ppu
            y = float(c.par.Viewy.eval()) - (eh / ppu) / 2 + v * eh / ppu
            return x * unit, y * unit

        def _onRebuildPulse(self, par: Par) -> None:
            self.RebuildLayout()

        @staticmethod
        def _fmt(v) -> str:
            if isinstance(v, float):
                return ('%.6f' % v).rstrip('0').rstrip('.') if v != int(v) else str(int(v))
            return str(v)
  dat_content_format: text
- name: screens_exec
  type: datexecuteDAT
  parameters:
    fromop: =parent()
    dat: screens
  flags:
  - viewer
  position: [400, 0]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
  dat_content: |
    # Any edit to the screens table (a typed cm value, a drag in the editor) re-derives the layout table.

    def onTableChange(dat):
        parent.ScreenMap.RebuildLayout()
        return

    def onRowChange(dat, rows):
        return

    def onColChange(dat, cols):
        return

    def onCellChange(dat, cells, prev):
        return

    def onSizeChange(dat):
        return
  dat_content_format: text
- name: window_editor
  type: windowCOMP
  parameters:
    winop: editor
    title: ScreenMap editor
    display: 1
  flags:
  - viewer
  position: [1600, 0]
  size: [160, 130]
  color: [0.67, 0.67, 0.67]
annotations:
- name: annotate1
  mode: annotate
  title: 'ScreenMap: physical screen layout'
  text: 'screens (EDIT THIS TABLE) is the single source of truth: one row per screen -- centre xcm/ycm and size wcm/hcm in centimetres, native pxw/pxh (0 = unknown), output display index, depth (stacking order: 0 = the back). screens_exec re-derives the layout and groups tables on every edit; layout holds world units (cm / Cmperunit), tz/layer from depth, the per-group crop pixels (group bounding box fitted and centred into the Panew x Paneh hydra pane) and the editor pixels; groups holds each interactive group''s whole canvas in editor pixels. The mockup in base1 (rect_* incl. tz, crop_g*) and window_u* read layout via op.ScreenMap.Layout / Px / Display expressions. editor: left-drag a screen tile to move it (Snapcm snaps); right-click a tile to send that screen to the back (rclick_exec); hovering a group''s tile reveals the group''s full hydra pane behind it at Ghostopacity (ghost_g1..3); open it with window_editor. Viewx/Viewy/Vieww frame the editor view. parexec routes parameter changes to the extension.'
  position: [-70, -270]
  size: [1900, 930]
  color: [0.25, 0.35, 0.45]
