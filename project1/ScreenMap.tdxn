format: tdxn
version: '2.1'
build: 4
generator: Embody/6.2.56
td_build: 099.2025.33230
network_path: /project1/ScreenMap
options:
  include_dat_content: false
  include_storage: true
type_defaults:
  containerCOMP:
    parameters:
      repocomp: =me
      resizecomp: =me
    size: [160, 130]
    color: [0.67, 0.67, 0.67]
  panelexecuteDAT:
    parameters:
      fromop: =parent()
      panels: screen_*
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  tableDAT:
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
type: baseCOMP
custom_pars:
  ScreenMap:
  - name: Mockup
    style: COMP
    label: Mockup COMP
    default: base1
    help: 'The COMP holding the mockup: rect_<screen> rectangle POPs and crop_<screen> Crop TOPs that this tool drives, plus the crop_paneN group canvases.'
    value: /project1/base1
  - name: Cmperunit
    style: Float
    label: cm per World Unit
    default: 100
    min: 0.001
    clampMin: true
    normMin: 1.0
    normMax: 200.0
    help: How many centimetres one world unit of the mockup represents. The rectangles are sized as cm / this value. 100 means 1 unit = 1 m.
  - name: Panew
    style: Int
    label: Group Canvas Width
    default: 1280
    min: 1.0
    clampMin: true
    normMax: 3840.0
    help: Pixel width of each interactive group canvas (the hydra pane the crops cut from).
  - name: Paneh
    style: Int
    label: Group Canvas Height
    default: 720
    min: 1.0
    clampMin: true
    normMax: 2160.0
    help: Pixel height of each interactive group canvas.
  - name: Viewx
    style: Float
    label: Editor View Centre X
    startSection: true
    normMin: -5.0
    normMax: 5.0
    help: World-unit X at the centre of the editor panel.
  - name: Viewy
    style: Float
    label: Editor View Centre Y
    normMin: -5.0
    normMax: 5.0
    help: World-unit Y at the centre of the editor panel.
  - name: Vieww
    style: Float
    label: Editor View Width
    default: 5.4
    min: 0.1
    clampMin: true
    normMin: 1.0
    normMax: 20.0
    help: How many world units the editor panel spans horizontally. Smaller = zoomed in.
  - name: Snapcm
    style: Float
    label: Drag Snap (cm)
    clampMin: true
    normMax: 50.0
    help: Dragged screen positions snap to multiples of this many cm. 0 = no snapping.
  - name: Rebuild
    style: Pulse
    label: Rebuild Layout
    startSection: true
    help: Recompute the layout table from the screens table. Normally automatic on every table edit.
  - name: Ghostopacity
    style: Float
    label: Hover Ghost Opacity
    default: 0.15
    clampMin: true
    clampMax: true
    help: Opacity of the full group canvas (the whole hydra pane) shown behind a group while the cursor is over one of its screens in the editor.
parameters:
  parentshortcut: ScreenMap
  opshortcut: ScreenMap
sequences:
  ext:
  - object: op('./ScreenMapExt').module.ScreenMapExt(me)
    name: ScreenMap
    promote: true
flags:
- viewer
color: [0.3, 0.5, 0.9]
tags:
- tdxn
