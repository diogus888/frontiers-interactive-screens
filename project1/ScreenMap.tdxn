    position: [800, -200]
  - name: ghost_g3
    type: containerCOMP
    parameters:
      x: =parent.ScreenMap.GroupLayout('g3', 'panx')
      y: =parent.ScreenMap.GroupLayout('g3', 'pany')
      w: =parent.ScreenMap.GroupLayout('g3', 'panw')
      h: =parent.ScreenMap.GroupLayout('g3', 'panh')
      top: =parent.ScreenMap.GroupTOP('g3')
      opacity: =parent.ScreenMap.par.Ghostopacity if parent.ScreenMap.GroupHovered('g3') else 0
    position: [800, -400]
  - name: drag_exec
    type: panelexecuteDAT
    parameters:
      panelvalue: lselect
      whileon: true
      ontooff: true
    position: [1000, 0]
    dat_content: |
      # Drag a screen tile to move that screen. The cursor is read on the editor (this DAT's parent),
      # converted to cm through the extension, and written to the screens table via setScreenPosition,
      # which re-derives the layout so every tile, mockup rectangle and crop follows.

      def _name(panelValue):
          return panelValue.owner.name[len('screen_'):]


      def _cursorCm():
          editor = parent()
          return parent.ScreenMap.ext.ScreenMap.editorToCm(editor.panel.insideu, editor.panel.insidev)


      def onOffToOn(panelValue):
          if not parent.ScreenMap.extensionsReady:
              return
          try:
              name = _name(panelValue)
              t = parent.ScreenMap.op('screens')
              cx, cy = float(t[name, 'xcm']), float(t[name, 'ycm'])
              mx, my = _cursorCm()
              parent().store('drag', {'name': name, 'dx': cx - mx, 'dy': cy - my, 'last': (cx, cy)})
          except Exception as e:
              debug('drag start failed: %s' % e)
          return


      def whileOn(panelValue):
          if not parent.ScreenMap.extensionsReady:
              return
          try:
              d = parent().fetch('drag', None)
              if not d or d['name'] != _name(panelValue):
                  return
              mx, my = _cursorCm()
              x, y = mx + d['dx'], my + d['dy']
              lx, ly = d['last']
              if abs(x - lx) < 0.01 and abs(y - ly) < 0.01:
                  return
              d['last'] = (x, y)
              parent().store('drag', d)
              parent.ScreenMap.ext.ScreenMap.setScreenPosition(d['name'], x, y)
          except Exception as e:
              debug('drag failed: %s' % e)
          return


      def onOnToOff(panelValue):
          parent().unstore('drag')
          return


      def whileOff(panelValue):
          return


      def onValueChange(panelValue):
          return
    dat_content_format: text
