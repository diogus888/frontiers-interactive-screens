- name: parexec
  type: parameterexecuteDAT
  parameters:
    fromop: =parent()
    op: ..
  flags:
  - viewer
  position: [400, 400]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
  dat_content: |
    # Routes ScreenMap parameter events to _on<Par>Pulse / _on<Par>ValueChange handlers on the extension.

    def _dispatch(suffix, *args):
        par = args[0]
        ext = parent.ScreenMap.ext.ScreenMap
        handler = getattr(ext, '_on%s%s' % (par.name, suffix), None)
        if handler is None:
            return
        try:
            handler(*args)
        except Exception as e:
            debug('ScreenMap %s handler failed: %s' % (par.name, e))


    def onValueChange(par, prev):
        if par.name in ('Cmperunit', 'Panew', 'Paneh', 'Viewx', 'Viewy', 'Vieww'):
            parent.ScreenMap.RebuildLayout()      # every derived value depends on these
        _dispatch('ValueChange', par, prev)
        return


    def onPulse(par):
        _dispatch('Pulse', par)
        return


    def onExpressionChange(par, val, prev):
        return


    def onExportChange(par, val, prev):
        return


    def onEnableChange(par, val, prev):
        return


    def onModeChange(par, val, prev):
        return
  dat_content_format: text
