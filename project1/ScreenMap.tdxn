  - name: rclick_exec
    type: panelexecuteDAT
    parameters:
      panelvalue: rselect
    position: [1000, -200]
    dat_content: |
      # Right-click on a screen tile: send that screen to the back (depth 0). Both the mockup's Z order
      # (rect tz) and the editor tile layer follow the screens table's depth column.

      def onOffToOn(panelValue):
          if not parent.ScreenMap.extensionsReady:
              return
          name = panelValue.owner.name
          if not name.startswith('screen_'):
              return
          try:
              parent.ScreenMap.ext.ScreenMap.sendToBack(name[len('screen_'):])
          except Exception as e:
              debug('sendToBack failed for %s: %s' % (name, e))
          return

      def whileOn(panelValue):
          return

      def onOnToOff(panelValue):
          return

      def whileOff(panelValue):
          return

      def onValueChange(panelValue):
          return
    dat_content_format: text
