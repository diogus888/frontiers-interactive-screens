    h: 720
    bgcolorr: 0.12
    bgcolorg: 0.12
    bgcolorb: 0.12
    bgalpha: 1
    drag: usecallbacks
  flags:
  - viewer
  position: [1200, 0]
  children:
  - name: ghost_g1
    type: containerCOMP
    parameters:
      x: =parent.ScreenMap.GroupLayout('g1', 'panx')
      y: =parent.ScreenMap.GroupLayout('g1', 'pany')
      w: =parent.ScreenMap.GroupLayout('g1', 'panw')
      h: =parent.ScreenMap.GroupLayout('g1', 'panh')
      top: =parent.ScreenMap.GroupTOP('g1')
      opacity: =parent.ScreenMap.par.Ghostopacity if parent.ScreenMap.GroupHovered('g1') else 0
    position: [800, 0]
  - name: ghost_g2
    type: containerCOMP
    parameters:
      x: =parent.ScreenMap.GroupLayout('g2', 'panx')
      y: =parent.ScreenMap.GroupLayout('g2', 'pany')
