- name: clip_switcher
  type: executeDAT
  parameters:
    fromop: =parent()
    framestart: true
  position: [3700, -7200]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
  storage:
    lastRow: 4
    nextSwitch: 468.7342366691
  dat_content: "\"\"\"Clip switcher for the NON-INTERACTIVE screens (movie_u01..movie_u07).\n\nAll clips live in ONE HAP movie, Hydra/clips-all.mov: 600 frames per clip, in the\norder listed by clip_list (Hydra/clips-all.txt). Each player uses Specify Index and\nreads its row of clip_state: start = first frame of its clip, t0 = absTime.frame when\nthe clip began. Every random 5..10 s one random screen (never the one changed last\ntime) gets a clip not already playing. Switching rewrites table cells only -- no file\nis opened or closed at runtime (swapping PNG-sequence folders crashed TD on the Mac).\n\"\"\"\nimport random\n\nCLIP_FRAMES = 600\nMIN_S, MAX_S = 5.0, 10.0\n\n\ndef _switchOneScreen():\n\tstate = op('clip_state')\n\tnames = op('clip_list').text.split()\n\tscreens = list(range(1, state.numRows))\n\tlast = me.fetch('lastRow', -1)\n\trow = random.choice([r for r in screens if r != last] or screens)\n\tplaying = {state[r, 'clip'].val for r in screens}\n\tclip = random.choice([n for n in names if n not in playing] or names)\n\tstate[row, 'clip'] = clip\n\tstate[row, 'start'] = names.index(clip) * CLIP_FRAMES\n\tstate[row, 't0'] = int(absTime.frame)\n\tme.store('lastRow', row)\n\n\ndef onFrameStart(frame):\n\tnow = absTime.seconds\n\tdue = me.fetch('nextSwitch', 0.0)\n\tif due - now > MAX_S:  # stale value saved from an earlier session\n\t\tdue = 0.0\n\tif now >= due:\n\t\tif due:\n\t\t\t_switchOneScreen()\n\t\tme.store('nextSwitch', now + random.uniform(MIN_S, MAX_S))\n\treturn\n"
  dat_content_format: text
