- name: midi_to_web
  type: chopexecuteDAT
  parameters:
    fromop: =parent()
    chop: midiin_apc
  flags:
  - viewer
  position: [-475, 375]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
  dat_content: |
    # Pushes APC mini mk2 values from midiin_apc into the hydra page in webrender1.
    #
    # The embedded Chromium in a Web Render TOP has no MIDI permission dialog, so
    # Web MIDI never works there. Instead the page's lib/midi.js exposes
    # midi.set(type, number, value, channel), and cc(n) / note(n) in the sketch
    # read what we push. The /split page forwards midi.set into every pane.
    #
    # midiin_apc runs in Automatic mode: channels appear as ch<midi channel>ctrl<cc>
    # and ch<midi channel>note<note> (0-based, "1 Based Index" is off) with RAW
    # 0..127 values -- they are scaled to 0..1 here, which is what the sketch expects.
    #
    # Only the five classic callbacks fire in this build (onValueChange per channel);
    # there is no batched onValuesChanged, so each changed channel is one call.
    # Do not write to me.storage in here: it creates a cook dependency loop on this DAT.
    import re

    _NAME = re.compile(r'^ch(\d+)(ctrl|note|c|n)(\d+)$')
    _KIND = {'ctrl': 'cc', 'c': 'cc', 'note': 'note', 'n': 'note'}


    def _webrender():
        web = op('webrender1')
        return web if web is not None and web.par.active.eval() else None


    def _call(channel, val):
        m = _NAME.match(channel.name)
        if not m:
            return None
        midi_ch, kind, number = m.groups()
        v = max(0.0, min(1.0, float(val) / 127.0))
        return 'midi.set(%r,%s,%.4f,%s)' % (_KIND[kind], number, v, midi_ch)


    def push(pairs):
        """Send [(channel, value), ...] to the page in one round trip. Returns the count sent."""
        web = _webrender()
        if web is None:
            return 0
        calls = [c for c in (_call(ch, v) for ch, v in pairs) if c]
        if calls:
            # no-op until the page has loaded lib/midi.js
            web.executeJavaScript('if(window.midi&&midi.set){%s}' % ';'.join(calls))
        return len(calls)


    def pushAll():
        """Re-send every current channel value, e.g. after the page reloads."""
        chop = op('midiin_apc')
        if chop is None:
            return 0
        return push([(c, c.eval()) for c in chop.chans()])


    def onValueChange(channel, sampleIndex, val, prev):
        push([(channel, val)])
        return


    def onOffToOn(channel, sampleIndex, val, prev):
        return

    def whileOn(channel, sampleIndex, val, prev):
        return

    def onOnToOff(channel, sampleIndex, val, prev):
        return

    def whileOff(channel, sampleIndex, val, prev):
        return
  dat_content_format: text
