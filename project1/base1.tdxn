    color: [0.67, 0.67, 0.67]
  inPOP:
    parameters:
      label: =me.name
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  mergePOP:
    parameters:
      uniquegroupname: true
    flags:
    - viewer
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  moviefileinTOP:
    parameters:
      file: Hydra/clips-all.mov
      index: =int(op('clip_state')[me.name, 'start']) + (int(absTime.frame) - int(op('clip_state')[me.name, 't0'])) % 600
      overridesample: true
      playmode: specify
      prereadframes: 10
      samplerate: 60
      timecodeop: =tdu.Timecode()
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  nullPOP:
    flags:
    - display
    - render
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  rectanglePOP:
